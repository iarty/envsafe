{
  "name": "@abarbonov/envsafe",
  "version": "0.0.0",
  "description": "Type-safe environment variable validation for Zod and Valibot.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./zod": {
      "types": "./dist/adapters/zod.d.ts",
      "import": "./dist/zod.js",
      "require": "./dist/zod.cjs",
      "default": "./dist/zod.js"
    },
    "./valibot": {
      "types": "./dist/adapters/valibot.d.ts",
      "import": "./dist/valibot.js",
      "require": "./dist/valibot.cjs",
      "default": "./dist/valibot.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "node": {
        "import": "./dist/node.js",
        "require": "./dist/node.cjs"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mts,cts,js,mjs,cjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,mts,cts,js,mjs,cjs,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "pack:check": "npm pack --dry-run --cache .npm-cache"
  },
  "peerDependencies": {
    "valibot": "^1.0.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "valibot": "^1.4.2",
    "vite": "^7.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
