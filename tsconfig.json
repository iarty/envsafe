{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "paths": {
      "@/*": ["./src/*"],
      "@abarbonov/envsafe": ["./src/index.ts"],
      "@abarbonov/envsafe/zod": ["./src/adapters/zod.ts"],
      "@abarbonov/envsafe/valibot": ["./src/adapters/valibot.ts"],
      "@abarbonov/envsafe/node": ["./src/node/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "example/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
